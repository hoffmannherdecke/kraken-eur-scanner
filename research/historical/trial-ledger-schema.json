{
  "schema_version": 1,
  "kind": "HISTORICAL_TRIAL_LEDGER_SCHEMA_V1",
  "required_fields": [
    "trial_id",
    "created_at_utc",
    "parent_hypothesis",
    "strategy_revision",
    "code_fingerprint",
    "feature_schema_version",
    "dataset_snapshot",
    "dataset_sha256",
    "universe_method",
    "train_window",
    "calibration_window",
    "validation_window",
    "holdout_window",
    "purge_seconds",
    "embargo_seconds",
    "fee_model",
    "spread_model",
    "slippage_model",
    "fill_ordering_policy",
    "stop_policy",
    "ttl_policy",
    "sizing_policy",
    "parameters",
    "metrics",
    "influenced_later_design"
  ],
  "field_contracts": {
    "trial_id": "immutable unique text id",
    "created_at_utc": "UTC ISO-8601 timestamp",
    "parent_hypothesis": "issue/doc/research hypothesis reference",
    "strategy_revision": "frozen strategy identifier",
    "code_fingerprint": "commit or content hash",
    "feature_schema_version": "versioned feature contract",
    "dataset_snapshot": "archive/build identifier",
    "dataset_sha256": "source archive checksum",
    "universe_method": "historical universe construction method + quality flag",
    "train_window": "closed-open UTC interval",
    "calibration_window": "closed-open UTC interval",
    "validation_window": "closed-open UTC interval",
    "holdout_window": "closed-open UTC interval or null before sealed use",
    "purge_seconds": "nonnegative integer",
    "embargo_seconds": "nonnegative integer",
    "fee_model": "explicit versioned fee assumptions",
    "spread_model": "explicit point-in-time or conservative proxy rule",
    "slippage_model": "explicit versioned rule",
    "fill_ordering_policy": "intrabar ambiguity rule",
    "stop_policy": "explicit versioned rule",
    "ttl_policy": "explicit versioned rule",
    "sizing_policy": "explicit versioned rule",
    "parameters": "JSON object; every varied setting recorded",
    "metrics": "JSON object; no best-only cherry-pick",
    "influenced_later_design": "boolean"
  },
  "invariants": [
    "trial_id is never reused",
    "dataset snapshot and checksum are immutable",
    "parameter sweep members are separate trials",
    "holdout results cannot be used to retune and remain called pristine holdout",
    "fee/spread/slippage/fill-policy changes create distinct trials",
    "strategy/runtime production state is never mutated by historical trials"
  ],
  "baseline_execution": {
    "taker_fee_pct_per_side": 0.6,
    "leverage": false,
    "same_bar_stop_target": "fail_conservative_or_lower_resolution_required"
  }
}
