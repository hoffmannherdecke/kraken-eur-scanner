+def _followup_batch_candidates(pending, pairs, checked, pair_checked):
+    """At most four distinct pairs, oldest observation first; no second writer."""
+    remaining = set(pending)
+    selected = []
+    while remaining and len(selected) < 4:
+        cid = _choose_followup_candidate(remaining, pairs, checked, pair_checked)
+        selected.append(cid)
+        pair = pairs[cid]
+        remaining = {other for other in remaining if pairs[other] != pair}
+    return selected
 
 
