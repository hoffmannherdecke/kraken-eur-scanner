+def _choose_followup_candidate(pending, pairs, checked, pair_checked):
+    """Rotate distinct market pairs first, then candidates within the pair.
+
+    Archive snapshots are pair-scoped. Scheduling one candidate per pair
+    before revisiting another candidate of the same pair minimizes avoidable
+    missed prospective capture windows without weakening a provenance gate.
+    The selected immutable candidate still passes the original phase checks.
+    """
+    return min(pending, key=lambda cid: (pair_checked.get(pairs[cid], 0),
+                                         checked.get(cid, 0), cid))
 
 
